# Copy this file to .env.local and fill in your own values.

# LAN IP address of your Lennox S30/E30/S40.
LENNOX_IP=192.168.1.100

# Identifier this app registers under with the device - any unique string.
LENNOX_APP_ID=nextjs_dashboard

# Long-poll timeout in seconds per retrieve cycle.
LENNOX_LONG_POLL=10

# Estimated AC cost - the device reports no real power metering, so this is a
# flat assumed wattage while actively cooling, and your local electricity
# rate. Adjust both to your actual equipment/utility rate.
AC_RUNNING_WATTS=4000
ELECTRICITY_RATE_PER_KWH=0.14
